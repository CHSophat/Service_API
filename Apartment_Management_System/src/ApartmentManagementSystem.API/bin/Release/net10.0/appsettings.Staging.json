{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.EntityFrameworkCore": "Warning",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "ApartmentDbSystem": "Server=staging-db.example.com;Port=5432;Database=apartment_db_staging;Username=staging_user;Password=staging_password;SslMode=Require;"
  },
  "Jwt": {
    "Secret": "${JWT_SECRET_STAGING}",
    "ExpiryMinutes": 60,
    "RefreshTokenExpiryDays": 7,
    "Issuer": "ApartmentManagementSystem",
    "Audience": "ApartmentManagementSystemAPI"
  },
  "Smtp": {
    "Host": "smtp.staging.example.com",
    "Port": 587,
    "Username": "${SMTP_USERNAME_STAGING}",
    "Password": "${SMTP_PASSWORD_STAGING}",
    "FromEmail": "noreply@apartment-staging.local",
    "FromName": "Apartment Management System Staging",
    "EnableSsl": true
  },
  "Google": {
    "ClientId": "${GOOGLE_CLIENT_ID_STAGING}",
    "ClientSecret": "${GOOGLE_CLIENT_SECRET_STAGING}",
    "RedirectUri": "https://api-staging.apartment-management.com/auth/callback"
  },
  "ApiConfiguration": {
    "Version": "v1",
    "Environment": "Staging",
    "ApiUrl": "https://api-staging.apartment-management.com",
    "WebUrl": "https://staging.apartment-management.com",
    "MobileUrl": "https://mobile-staging.apartment-management.com"
  },
  "Cors": {
    "AllowedOrigins": [
      "https://staging.apartment-management.com",
      "https://mobile-staging.apartment-management.com",
      "http://localhost:3000",
      "http://localhost:5173"
    ]
  },
  "AllowedHosts": "*",
  "Email": {
    "SmtpServer": "smtp.staging.example.com",
    "SmtpPort": 587,
    "SenderEmail": "noreply@staging.apartment-management.com",
    "IsProduction": false
  },
  "Stripe": {
    "PublishableKey": "${STRIPE_PUBLISHABLE_KEY_STAGING}",
    "SecretKey": "${STRIPE_SECRET_KEY_STAGING}"
  },
  "Firebase": {
    "ProjectId": "apartment-management-staging",
    "PrivateKeyId": "${FIREBASE_PRIVATE_KEY_ID_STAGING}",
    "PrivateKey": "${FIREBASE_PRIVATE_KEY_STAGING}"
  },
  "RateLimiting": {
    "Enabled": true,
    "RequestsPerMinute": 100
  }
}
