{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.EntityFrameworkCore": "Warning",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "ApartmentDbSystem": "Server=uat-db.example.com;Port=5432;Database=apartment_db_uat;Username=uat_user;Password=uat_password;SslMode=Require;"
  },
  "Jwt": {
    "Secret": "${JWT_SECRET_UAT}",
    "ExpiryMinutes": 60,
    "RefreshTokenExpiryDays": 7,
    "Issuer": "ApartmentManagementSystem",
    "Audience": "ApartmentManagementSystemAPI"
  },
  "Smtp": {
    "Host": "smtp.uat.example.com",
    "Port": 587,
    "Username": "${SMTP_USERNAME_UAT}",
    "Password": "${SMTP_PASSWORD_UAT}",
    "FromEmail": "noreply@apartment-uat.local",
    "FromName": "Apartment Management System UAT",
    "EnableSsl": true
  },
  "Google": {
    "ClientId": "${GOOGLE_CLIENT_ID_UAT}",
    "ClientSecret": "${GOOGLE_CLIENT_SECRET_UAT}",
    "RedirectUri": "https://api-uat.apartment-management.com/auth/callback"
  },
  "ApiConfiguration": {
    "Version": "v1",
    "Environment": "UAT",
    "ApiUrl": "https://api-uat.apartment-management.com",
    "WebUrl": "https://uat.apartment-management.com",
    "MobileUrl": "https://mobile-uat.apartment-management.com"
  },
  "Cors": {
    "AllowedOrigins": [
      "https://uat.apartment-management.com",
      "https://mobile-uat.apartment-management.com"
    ]
  },
  "AllowedHosts": "*",
  "Email": {
    "SmtpPort": 587,
    "SenderEmail": "noreply@uat.apartment-management.com",
    "IsProduction": false
  },
  "Stripe": {
    "PublishableKey": "${STRIPE_PUBLISHABLE_KEY_UAT}",
    "SecretKey": "${STRIPE_SECRET_KEY_UAT}"
  },
  "Firebase": {
    "ProjectId": "apartment-management-uat",
    "PrivateKeyId": "${FIREBASE_PRIVATE_KEY_ID_UAT}",
    "PrivateKey": "${FIREBASE_PRIVATE_KEY_UAT}"
  },
  "RateLimiting": {
    "Enabled": true,
    "RequestsPerMinute": 100
  }
}
