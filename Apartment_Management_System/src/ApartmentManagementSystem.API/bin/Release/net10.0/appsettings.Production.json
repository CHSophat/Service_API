{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.EntityFrameworkCore": "Error",
      "Microsoft.AspNetCore": "Error"
    }
  },
  "ConnectionStrings": {
    "ApartmentDbSystem": "Server=${DB_HOST_PROD};Port=5432;Database=${DB_NAME_PROD};Username=${DB_USER_PROD};Password=${DB_PASSWORD_PROD};SslMode=Require;"
  },
  "Jwt": {
    "Secret": "${JWT_SECRET_PROD}",
    "ExpiryMinutes": 30,
    "RefreshTokenExpiryDays": 30,
    "Issuer": "ApartmentManagementSystem",
    "Audience": "ApartmentManagementSystemAPI"
  },
  "Smtp": {
    "Host": "${SMTP_HOST_PROD}",
    "Port": 587,
    "Username": "${SMTP_USERNAME_PROD}",
    "Password": "${SMTP_PASSWORD_PROD}",
    "FromEmail": "noreply@apartment-management.com",
    "FromName": "Apartment Management System",
    "EnableSsl": true
  },
  "Google": {
    "ClientId": "${GOOGLE_CLIENT_ID_PROD}",
    "ClientSecret": "${GOOGLE_CLIENT_SECRET_PROD}",
    "RedirectUri": "https://api.apartment-management.com/auth/callback"
  },
  "ApiConfiguration": {
    "Version": "v1",
    "Environment": "Production",
    "ApiUrl": "https://api.apartment-management.com",
    "WebUrl": "https://app.apartment-management.com",
    "MobileUrl": "https://mobile.apartment-management.com"
  },
  "Cors": {
    "AllowedOrigins": [
      "https://app.apartment-management.com",
      "https://mobile.apartment-management.com"
    ]
  },
  "AllowedHosts": "*",
  "Email": {
    "SmtpPort": 587,
    "SenderEmail": "noreply@apartment-management.com",
    "IsProduction": true
  },
  "Stripe": {
    "PublishableKey": "${STRIPE_PUBLISHABLE_KEY_PROD}",
    "SecretKey": "${STRIPE_SECRET_KEY_PROD}"
  },
  "Firebase": {
    "ProjectId": "apartment-management-prod",
    "PrivateKeyId": "${FIREBASE_PRIVATE_KEY_ID_PROD}",
    "PrivateKey": "${FIREBASE_PRIVATE_KEY_PROD}"
  },
  "RateLimiting": {
    "Enabled": true,
    "RequestsPerMinute": 200
  },
  "EnableDetailedErrors": false
}
