{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.EntityFrameworkCore": "Debug",
      "Microsoft.AspNetCore": "Debug"
    }
  },
  "ConnectionStrings": {
    "ApartmentDbSystem": "Server=qa-db.example.com;Port=5432;Database=apartment_db_qa;Username=qa_user;Password=qa_password;SslMode=Require;"
  },
  "Jwt": {
    "Secret": "${JWT_SECRET_QA}",
    "ExpiryMinutes": 60,
    "RefreshTokenExpiryDays": 7,
    "Issuer": "ApartmentManagementSystem",
    "Audience": "ApartmentManagementSystemAPI"
  },
  "Smtp": {
    "Host": "smtp.qa.example.com",
    "Port": 587,
    "Username": "${SMTP_USERNAME_QA}",
    "Password": "${SMTP_PASSWORD_QA}",
    "FromEmail": "noreply@apartment-qa.local",
    "FromName": "Apartment Management System QA",
    "EnableSsl": true
  },
  "Google": {
    "ClientId": "${GOOGLE_CLIENT_ID_QA}",
    "ClientSecret": "${GOOGLE_CLIENT_SECRET_QA}",
    "RedirectUri": "https://api-qa.apartment-management.com/auth/callback"
  },
  "ApiConfiguration": {
    "Version": "v1",
    "Environment": "QA",
    "ApiUrl": "https://api-qa.apartment-management.com",
    "WebUrl": "https://qa.apartment-management.com",
    "MobileUrl": "https://mobile-qa.apartment-management.com"
  },
  "Cors": {
    "AllowedOrigins": [
      "https://qa.apartment-management.com",
      "https://mobile-qa.apartment-management.com",
      "http://localhost:3000",
      "http://localhost:5173"
    ]
  },
  "AllowedHosts": "*",
  "Email": {
    "SmtpServer": "smtp.qa.example.com",
    "SmtpPort": 587,
    "SenderEmail": "noreply@qa.apartment-management.com",
    "IsProduction": false
  },
  "Stripe": {
    "PublishableKey": "${STRIPE_PUBLISHABLE_KEY_QA}",
    "SecretKey": "${STRIPE_SECRET_KEY_QA}"
  },
  "Firebase": {
    "ProjectId": "apartment-management-qa",
    "PrivateKeyId": "${FIREBASE_PRIVATE_KEY_ID_QA}",
    "PrivateKey": "${FIREBASE_PRIVATE_KEY_QA}"
  },
  "RateLimiting": {
    "Enabled": true,
    "RequestsPerMinute": 150
  },
  "TestingMode": true
}
