
using System.Threading;
using System.Threading.Tasks;
using MediatR;
using Microsoft.EntityFrameworkCore;
using module_finance.Application.Common;
using module_finance.Application.DTOs.Command;
using module_finance.Domain.Entities;
using module_finance.Infrastructure.Persistence;

namespace module_finance.Application.Command
{
	public class CreateCustomerCommandHandler : IRequestHandler<CreateCustomerCommand, Result<int>>
	{
		private readonly ApplicationDbContext _context;
		public CreateCustomerCommandHandler(ApplicationDbContext context) => _context = context;

		public async Task<Result<int>> Handle(CreateCustomerCommand request, CancellationToken ct)
		{
			// Validation
			if (await _context.Customers.AnyAsync(c => c.Email == request.Email, ct))
				return Result.Failure<int>("Email already exists");

			var customer = Customer.Create(request.FirstName, request.LastName, request.Email);
			// Set optional properties...
			customer.UpdateTimestamp();

			_context.Customers.Add(customer);
			await _context.SaveChangesAsync(ct);

			return Result.Success(customer.CustomerId);
		}
	}
}
